{
  "name": "autonomous-infra-agent",
  "version": "0.2.0",
  "description": "Autonomous SRE agent: drafts a fix for a crashing service, proves it in a sandbox, and repairs it when it fails — with a deterministic safety gate the model cannot talk its way past.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "infra-agent": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "demo": "tsx src/demo.ts",
    "demo:built": "node dist/demo.js",
    "dev": "tsx src/cli.ts",
    "cli": "tsx src/cli.ts",
    "server": "tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests evals --ext .ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.evals.json --noEmit",
    "eval": "tsx evals/run.ts",
    "eval:generate": "tsx evals/run.ts --generate",
    "eval:full": "tsx evals/run.ts --full",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "keywords": [
    "sre",
    "incident-response",
    "remediation",
    "ollama",
    "local-llm"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitest/coverage-v8": "^2.1.5",
    "eslint": "^8.57.1",
    "pino-pretty": "^11.3.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
