# Required to run root-cause analysis and remediation generation.
ANTHROPIC_API_KEY=

# Model used for incident analysis and remediation drafting.
ANTHROPIC_MODEL=claude-sonnet-5

# Port for the optional webhook server that receives incident alerts.
PORT=8787

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Default Docker resource limits applied to sandbox verification runs.
SANDBOX_CPU_LIMIT=0.5
SANDBOX_MEMORY_LIMIT=256m

# Maximum seconds a sandbox verification run may execute before being killed.
SANDBOX_TIMEOUT_SECONDS=60
