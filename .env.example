# --- Where drafts come from ---------------------------------------------------
# ollama = a local model on this machine; replay = recorded drafts for the
# built-in demo scenarios (no GPU or model needed). `npm run demo` uses replay.
LLM_PROVIDER=ollama
# Simulated model latency in replay mode, so a live UI has time to show each stage.
REPLAY_DELAY_MS=700

# Base URL of a locally running Ollama server (`ollama serve`).
OLLAMA_BASE_URL=http://localhost:11434

# Model used to draft and repair fixes. Pull it first: `ollama pull qwen2.5-coder:7b`
OLLAMA_MODEL=qwen2.5-coder:7b

# Context window (tokens) requested from Ollama. Increase if you hit truncated
# drafts for larger files; must not exceed what the chosen model supports.
OLLAMA_NUM_CTX=8192

# Hard timeout for a single Ollama request. Ollama has no built-in request
# timeout, so a stuck or overloaded server would otherwise hang forever.
OLLAMA_REQUEST_TIMEOUT_SECONDS=180

# --- The repair loop ----------------------------------------------------------
# How many times a draft that fails verification may be sent back to the model
# with the real failure output (0-5).
MAX_REPAIR_ATTEMPTS=2

# --- Where drafts are proven --------------------------------------------------
# docker = isolated container (recommended). local = a child process on this
# machine with NO isolation, for demos only. off = never execute drafts.
SANDBOX_MODE=docker
# `local` runs generated commands with your privileges, so it refuses to start
# unless you explicitly confirm. Only set this for trusted (recorded) drafts.
SANDBOX_LOCAL_ACKNOWLEDGE=false

# Docker resource limits applied to each verification run.
SANDBOX_CPU_LIMIT=0.5
SANDBOX_MEMORY_LIMIT=256m

# Maximum seconds one verification run may execute before it is killed.
SANDBOX_TIMEOUT_SECONDS=60

# --- The server ---------------------------------------------------------------
# Interface to listen on. Loopback by default. A live model with SANDBOX_MODE=local
# refuses to start on any other interface (it would let visitors run commands here).
HOST=127.0.0.1
# Port for the dashboard and API.
PORT=8787

# Number of reverse proxies in front of the server (1 on most hosting
# platforms). Without it every visitor shares the proxy's IP and rate limit.
TRUST_PROXY=0

# Log level: silent | fatal | error | warn | info | debug | trace
LOG_LEVEL=info
