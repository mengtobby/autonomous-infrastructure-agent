# Base URL of a locally running Ollama server (`ollama serve`).
OLLAMA_BASE_URL=http://localhost:11431

# Model to use for root-cause analysis and remediation drafting.
# Pull it first: `ollama pull qwen2.5-coder:7b`
OLLAMA_MODEL=qwen2.5-coder:7b

# Context window (tokens) requested from Ollama. Increase if you hit
# truncated remediation drafts for larger files; must not exceed what the
# chosen model supports.
OLLAMA_NUM_CTX=8192

# Port for the optional webhook server that receives incident alerts.
PORT=8787

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Default Docker resource limits applied to sandbox verification runs.
SANDBOX_CPU_LIMIT=0.5
SANDBOX_MEMORY_LIMIT=256m

# Maximum seconds a sandbox verification run may execute before being killed.
SANDBOX_TIMEOUT_SECONDS=60
